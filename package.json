{
  "name": "ingesf",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "AI-free document ingestion pipeline: any paper -> checked question pack",
  "scripts": {
    "ui": "python3 -I ui/server.py",
    "test": "python3 -I ingest/tests/run_tests.py",
    "test:quick": "python3 -I ingest/tests/run_tests.py --quick",
    "papers": "sh ingest/tests/run_all_papers.sh"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "js-yaml": "5.5.0",
    "marked": "18.2.0",
    "playwright": "1.63.0",
    "temml": "0.14.0"
  }
}
