{
  "name": "Ingesf — document ingestion pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Ingesf UI", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml"],
      "settings": { "yaml.schemas": { "ingest/kit/profile.schema.json": "ingest/profiles/*.yaml", "ingest/kit/job.schema.json": "ingest/jobs/*.yaml" } }
    }
  }
}
